---
type Props = {
  name: string;
  category: string;
  description?: string;
};

const { name, category, description } = Astro.props;
---

<div class="interest">
  <div class=`title ${description ? "compact" : "wide"}`>
    <strong class="name">{name}</strong>
    <div style="flex:1;"></div>
    <span class="category">{category}</span>
  </div>

  {
    description && (
      <div class="detail">
        <span class="description">{description}</span>
      </div>
    )
  }
</div>

<style lang="scss">
  .interest {
    position: absolute;
    transform-origin: center center;
    margin: 0;

    display: flex;
    flex-direction: column;
    gap: 8px;

    min-width: 200px;

    box-sizing: border-box;
    margin: 0;
    border-radius: 5px;

    background: var(--card-bg);
    color: var(--card-fg);

    user-select: none;
    cursor: grab;

    &:active {
      cursor: grabbing;
    }

    .title {
      display: flex;
      gap: 1rem;
      &.compact {
        padding-inline: 16px;
        padding-top: 8px;
      }
      &.wide {
        padding-inline: 16px;
        padding-block: 8px;
      }
      align-items: center;

      * {
        flex-shrink: 0;
        white-space: nowrap;
      }

      .category {
        display: flex;
        align-items: center;
        background: color-mix(in srgb, currentColor 10%, transparent);
        padding: 0.5rem;
        font-size: 0.7rem;
        font-weight: 600;
        text-transform: lowercase;
        height: 1.2rem;
        border-radius: 2px;
      }

      .name {
        font-size: 1.1rem;
        font-weight: 650;
        letter-spacing: -0.025em;
      }
    }

    .detail {
      background-color: color-mix(in srgb, currentColor 10%, transparent);
      margin: auto 0 0;
      font-size: 0.8rem;
      padding-inline: 16px;
      padding-block: 8px;
      text-align: center;

      .description {
        padding: 4px 9px;
        border-radius: 6px;
        color: var(--card-fg);
        font-weight: 500;
      }
    }
  }
</style>
